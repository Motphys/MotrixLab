    <velocimeter name="imu_lin_vel" site="imu"/>
    <accelerometer name="imu_lin_acc" site="imu"/>
    <subtreeangmom name="root_angmom" body="body"/>
    <!-- Required by the quadruped walk task. Names and reference frames mirror
         go2_mjx.xml; foot positions are body-relative (ref=imu) because the
         swing reward compares them against body-frame target heights. -->
    <framezaxis name="upvector" objtype="site" objname="imu"/>
    <framepos name="FL_pos" objtype="site" objname="FL" reftype="site" refname="imu"/>
    <framepos name="FR_pos" objtype="site" objname="FR" reftype="site" refname="imu"/>
    <framepos name="RL_pos" objtype="site" objname="RL" reftype="site" refname="imu"/>
    <framepos name="RR_pos" objtype="site" objname="RR" reftype="site" refname="imu"/>
  </sensor>
