<mujoco model="cyberdog2">
  <compiler angle="radian" meshdir="assets" autolimits="true" />
  <default>
    <default class="cyberdog2">
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" density="0" group="2"/>
      </default>
      <default class="collision">
        <geom priority="1" condim="6" group="3"/>
      </default>
      <site rgba="1 0 0 1" group="5"/>
      <!-- Joint/actuator defaults use the CyberDog2 hardware values rather than
           the Go2 ones (cf. go2_mjx.xml, class "go2"):
             - joint damping 0.01 N*m*s/rad: <dynamics damping="0.01"/> in
               cyberdog2.urdf (const.xacro abad/hip/knee_damping).
             - armature = rotor inertia reflected through the 7.75:1 gearbox:
               4.78e-5 kg*m^2 * 7.75^2 = 2.87e-3 kg*m^2 (rotor_izz in const.xacro).
             - kp=20, kv=0.5: RL velocity-controller PD gains from
               fsm_state_rl_velocity.cpp (kp_mat_/kd_mat_).
             - forcerange 12.0001 N*m: joint torque limit from
               cyberdog2-description.yaml (*_torque_max); equals the 1.5484 N*m
               motor torque * 7.75 gear ratio from const.xacro. -->
      <joint damping="0.01" armature="0.00287"/>
      <position kp="20" kv="0.5" forcerange="-12.0001 12.0001"/>
      <!-- Go2 gives each joint group its own ctrlrange default. CyberDog2's
           front and rear hip joints have different ranges, so they are split. -->
      <default class="abad">
        <position ctrlrange="-0.5807 0.5807"/>
      </default>
      <default class="hip_front">
        <position ctrlrange="-1.2265 2.6925"/>
      </default>
      <default class="hip_rear">
        <position ctrlrange="-0.8774 3.0416"/>
      </default>
      <default class="knee">
        <position ctrlrange="-2.4307 -0.6236"/>
      </default>
    </default>
  </default>
