    <position class="abad" name="FL_abad" joint="FL_abad_joint"/>
    <position class="hip_front" name="FL_hip" joint="FL_hip_joint"/>
    <position class="knee" name="FL_knee" joint="FL_knee_joint"/>
    <position class="abad" name="FR_abad" joint="FR_abad_joint"/>
    <position class="hip_front" name="FR_hip" joint="FR_hip_joint"/>
    <position class="knee" name="FR_knee" joint="FR_knee_joint"/>
    <position class="abad" name="RL_abad" joint="RL_abad_joint"/>
    <position class="hip_rear" name="RL_hip" joint="RL_hip_joint"/>
    <position class="knee" name="RL_knee" joint="RL_knee_joint"/>
    <position class="abad" name="RR_abad" joint="RR_abad_joint"/>
    <position class="hip_rear" name="RR_hip" joint="RR_hip_joint"/>
    <position class="knee" name="RR_knee" joint="RR_knee_joint"/>
  </actuator>
